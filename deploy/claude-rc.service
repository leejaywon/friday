[Unit]
Description=Claude Code Remote Control (reach it from the Claude iPhone app)
After=network-online.target
Wants=network-online.target

# Runs inside tmux so you can look at it with:  tmux attach -t claude-rc  (detach: Ctrl-b d)
# The loop restarts Remote Control if it exits.
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/code
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s claude-rc -c %h/code "while true; do claude remote-control --name vps; sleep 10; done"
ExecStop=/usr/bin/tmux kill-session -t claude-rc

[Install]
WantedBy=default.target
