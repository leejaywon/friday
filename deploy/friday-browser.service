[Unit]
Description=Friday's shared headless browser (Google Chrome, DevTools on 127.0.0.1:9222)
After=network-online.target friday-audio.service
Wants=network-online.target
Requires=friday-audio.service

# Google Chrome Stable (deploy/bootstrap.sh installs it, with the AppArmor profile its sandbox
# needs and a policy that blocks file:// pages). The profile in ~/friday-data/browser keeps
# logins across restarts; restore-last-session also retains session cookies. The DevTools port
# (src/friday/browser.py CDP_PORT) gives full control
# of the logged-in browser, so it listens on 127.0.0.1 only.
[Service]
Environment=PULSE_SERVER=unix:%t/friday-audio/native
Environment=PULSE_SINK=friday_browser
ExecStart=/usr/bin/google-chrome-stable \
  --headless --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 \
  --user-data-dir=%h/friday-data/browser --restore-last-session --no-first-run --no-default-browser-check \
  --audio-buffer-size=8192 \
  --lang=ko-KR --window-size=1280,900 about:blank
Restart=always
RestartSec=5
MemoryMax=2G

[Install]
WantedBy=default.target
