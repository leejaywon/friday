# Copy to .env.server (deploy/setup.sh does this and asks for the values), fill in, and
# deploy/push.sh uploads it as ~/friday/.env on the server. Never commit .env.server.

# From @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id. Leave empty on first start: message the bot and it replies with your id.
TELEGRAM_ALLOWED_USER_IDS=

# Your timezone, as an IANA name (Europe/Paris, America/New_York, Asia/Seoul, ...). Empty = UTC.
# deploy/setup.sh suggests your Mac's. Change it any time from Telegram with /tz Europe/Paris.
FRIDAY_TZ=

# Where the database, files and Google token live on the server.
FRIDAY_DATA_DIR=/home/friday/friday-data

# Minutes before a calendar event to send a heads-up.
MEETING_LEAD_MIN=10

# Daily summary time (HH:MM, your timezone). Empty turns it off.
MORNING_BRIEF_AT=08:00

# The AI Friday chats with (and uses for browser runs and watches): codex (a ChatGPT plan, through
# the Codex CLI) or claude (a Claude plan, through Claude Code). Empty = codex.
CHAT_ENGINE=

# Default model (and Codex's reasoning effort). Empty = the CLI's defaults. /model in Telegram
# overrides these.
CODEX_MODEL=
CODEX_EFFORT=
# opus, sonnet or haiku.
CLAUDE_MODEL=

# Web search for Friday: live, cached or disabled.
FRIDAY_WEB_SEARCH=live

# GitHub access through GitHub's MCP server. Create a fine-grained token at
# https://github.com/settings/personal-access-tokens (read-only permissions recommended).
GITHUB_TOKEN=
# true = Friday can only read GitHub, even if the token allows writing.
GITHUB_READONLY=true

# Coding jobs (/code): a separate fine-grained token with only the repos Friday may change,
# Contents and Pull requests: Read and write. Friday pushes branches and opens PRs with it;
# it's kept out of the agents' environment.
GITHUB_CODE_TOKEN=
# Default coding agent: claude or codex.
CODE_ENGINE=claude
# Seconds before a coding job is stopped.
# CODE_JOB_TIMEOUT_SECONDS=3600

# Friday's Mini App (the form behind 📝 Open form, site/app/). Unset = the copy this repo publishes,
# https://leejaywon.github.io/friday/app/; any https address of your own copy works; empty = no
# button, requests are answered by reply only.
# FRIDAY_APP_URL=

# Seconds before a single Codex run is stopped.
# CODEX_TIMEOUT_SECONDS=600

# Chat turns run in one long-lived `codex app-server` (faster replies); false = `codex exec` per
# message, which is also the automatic fallback when the app-server fails.
# FRIDAY_CODEX_SERVER=true

# Chat messages answered at the same time. One sent while the conversation is busy starts in a
# side conversation instead of waiting; only one of them uses the browser at a time. 1 = one by one.
# CHAT_LANES=3

# The shared headless browser (deploy/friday-browser.service) and saved logins. false turns it off.
# FRIDAY_BROWSER=true

# Voice messages: Friday transcribes them and answers what you said. Get a key at
# https://console.groq.com/keys (Groq Whisper; fast and cheap). Empty = voice messages are only saved.
# Friday removes this key from its environment, so the agents don't get it in theirs.
TRANSCRIBE_API_KEY=
# groq (default) or openai (then use an OpenAI API key above).
# TRANSCRIBE_PROVIDER=groq
# Empty = the provider's default (whisper-large-v3-turbo / gpt-4o-mini-transcribe).
# TRANSCRIBE_MODEL=
# Force a language (ISO code like ko or en). Empty = detected per message.
# TRANSCRIBE_LANGUAGE=

# Timings, in seconds. Starting values picked by feel, not measured: adjust if they feel off.
#
# A file sent without a caption: Friday waits this long for a message about it,
# then answers the file on its own. Shorter = faster reply, longer = more time to type.
# FILE_FOLLOWUP_WAIT_SECONDS=4
#
# A message sent right after a file waits up to this long for the file to finish downloading,
# so both are answered together.
# FILE_DOWNLOAD_WAIT_SECONDS=10
#
# Friday gives up on transcribing one recording after this long and keeps the file instead.
# TRANSCRIBE_TIMEOUT_SECONDS=120
